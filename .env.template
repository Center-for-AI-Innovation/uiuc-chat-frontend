# Frontend .env.template — mirror of the kept-keys set in `.env`.
# See /Users/rmp6/Documents/cropwizard/cleaned.env for the canonical superset
# used during local development.

# =============================================================================
# OPENAI & LLM
# =============================================================================
OPENAI_API_KEY=
VLADS_OPENAI_KEY="${OPENAI_API_KEY}"
NCSA_HOSTED_API_KEY=
NCSA_HOSTED_VLM_BASE_URL=
OLLAMA_SERVER_URL=

# =============================================================================
# EMBEDDINGS
# =============================================================================
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_BASE=
# Allow-list (comma-separated, lowercased) for per-project
# `embedding_config.provider` values. Tightens the Zod schema in
# `src/utils/projectConnections/validation.ts` and the backend's
# `_resolve_embedding_client` whitelist. Default: openai,ollama.
ALLOWED_EMBEDDING_PROVIDERS=openai,ollama

# =============================================================================
# REDIS
# =============================================================================
INGEST_REDIS_HOST="redis"
INGEST_REDIS_PORT="6379"
INGEST_REDIS_PASSWORD="your-strong-password-here"
REDIS_URL="redis://default:${INGEST_REDIS_PASSWORD}@localhost:6379"
REDIS_PASSWORD="${INGEST_REDIS_PASSWORD}"

# =============================================================================
# SERVICE PORTS / URLS
# =============================================================================
FRONTEND_PORT=3001
FLASK_PORT=3012
RAILWAY_URL="http://127.0.0.1:8000"
INGEST_URL=http://127.0.0.1:8000/ingest
CRAWLEE_API_URL=

# =============================================================================
# OBJECT STORAGE
# =============================================================================
MINIO_ENDPOINT=
MINIO_KEY=
MINIO_SECRET=
AWS_REGION=
AWS_KEY=
AWS_SECRET=
# Legacy SDK-standard names also referenced in some code paths.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
LOCAL_MINIO=true

# =============================================================================
# POSTGRES
# =============================================================================
POSTGRES_PASSWORD=password
POSTGRES_ENDPOINT=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres

KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=password
KEYCLOAK_DB_ENDPOINT=localhost
KEYCLOAK_DB_PORT=5433
KEYCLOAK_DB_DATABASE=postgres

# =============================================================================
# QDRANT
# =============================================================================
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
QDRANT_URL=

# =============================================================================
# AUTH / KEYCLOAK
# =============================================================================
NEXT_PUBLIC_SIGNING_KEY=""
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=localhost
NEXT_PUBLIC_KEYCLOAK_URL=
NEXT_PUBLIC_KEYCLOAK_REALM=illinois_chat_realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=illinois_chat
# Comma-separated list of additional super-admin email addresses. Unioned
# with the hardcoded list in `src/utils/superAdmins.ts`.
SUPER_ADMIN_EMAILS=""

# =============================================================================
# ENCRYPTION (must match backend ENCRYPTION_MASTER_KEY)
# =============================================================================
# AES-256-GCM master key for `project_external_connections` JSONB columns.
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=""

# =============================================================================
# MISC
# =============================================================================
NEXT_PUBLIC_USE_ILLINOIS_CHAT_CONFIG=True
